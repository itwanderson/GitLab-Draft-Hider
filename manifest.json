{
  "manifest_version": 3,
  "name": "GitLab Draft Hider",
  "version": "0.1.0",
  "description": "Hides draft and parked merge requests on GitLab and shows them in a Hidden tab.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*"],
      "js": [
        "src/lib/classify.js",
        "src/lib/hosts.js",
        "src/lib/config.js",
        "src/lib/graphql.js",
        "src/lib/dom.js",
        "src/lib/reconcile.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GitLab Draft Hider"
  }
}
